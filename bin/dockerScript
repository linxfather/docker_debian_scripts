#!/bin/bash

arg1=$1
arg2=$2
arg3=$3
set -e

if [ "$arg1" = "create_dockerImage" ] && [ -n "$arg2" ]; then
    if [ -d "images/$arg2" ]; then
        echo "ERR: image $arg2 is already exists"
        exit 1
    fi
    cp -r images/baseimage images/$arg2
    echo "OK: image $arg2 created"
    exit
fi

if [ "$arg1" = "build_image" ] && [ -f "images/$arg2/Dockerfile" ]; then
    if [ "$arg3" != "-force" ]; then
        set +e
        line=$(docker images --format "{{.Repository}}" | grep -w $arg2)
        set -e
        if [ "$line" = "$arg2" ]; then
            echo "ERR: container already build"
            exit 1
        fi
    fi
    cd images/$arg2
    docker build -t $arg2 .
    echo "OK: image $arg2 build"
    exit
fi

# help
echo "HELP"
echo ":"
echo "bin/dockerScript create_dockerImage %IMAGE%"
echo "bin/dockerScript build_image %IMAGE% [-force]"
echo ":"
echo "Docker"
echo ":"
echo "RM IMAGE   --- docker rmi %IMAGE%"
echo "LIST IMAGE --- docker images"









