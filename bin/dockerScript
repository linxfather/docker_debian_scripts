#!/bin/bash

arg1=$1
arg2=$2
set -e

if [ "$arg1" = "create_dockerFile" ] && [ -n "$arg2" ]; then
    if [ -d "images/$arg2" ]; then
        echo "ERR: images is already exists"
        exit 1
    fi
    cp -r images/baseimage images/$arg2
    echo "OK: image $arg2 created"
    exit
fi

# help
echo "TODO HELP"




