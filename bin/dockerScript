#!/bin/bash

arg1=$1
arg2=$2
arg3=$3
set -e
source bin/.env

if [ "$arg1" = "create_dockerImage" ] && [ -n "$arg2" ]; then
    if [ -d "images/$arg2" ]; then
        echo "ERR: image $arg2 is already exists"
        exit 1
    fi
    cp -r images/baseimage images/$arg2
    echo "OK: image $arg2 created"
    exit
fi

if [ "$arg1" = "build_image" ] && [ -f "images/$arg2/Dockerfile" ]; then
    if [ "$arg3" != "-force" ]; then
        set +e
        line=$(docker images --format "{{.Repository}}" | grep -w $arg2)
        set -e
        if [ "$line" = "$arg2" ]; then
            echo "ERR: container already build"
            exit 1
        fi
    fi
    cd images/$arg2
    docker build -t $arg2 .
    echo "OK: image $arg2 build"
    # NEED to invalidate existing container
    set +e
    name="$namePrefix$arg2"
    line=$(docker ps -a --format "{{.Names}}" | grep -w $name)
    if [ "$line" = "$name" ]; then
        docker container rm -f $name
        echo "OK: container removed"
    fi
    #
    exit
fi

if [ "$arg1" = "run_image" ] && [ -f "images/$arg2/Dockerfile" ]; then
    set +e
    line=$(docker images --format "{{.Repository}}" | grep -w $arg2)
    set -e
    if [ "$line" != "$arg2" ]; then
        echo "ERR: container not build"
        exit 1
    fi
    name="$namePrefix$arg2"
    docker run -d --name $name -v $(realpath .):/home/project $arg2
    echo "OK: image $arg2 is running"
    exit
fi

if [ "$arg1" = "shell" ] && [ -f "images/$arg2/Dockerfile" ]; then
    set +e
    name="$namePrefix$arg2"
    docker exec -it $name bash
    exit
fi

if [ "$arg1" = "shell_as_root" ] && [ -f "images/$arg2/Dockerfile" ]; then
    set +e
    name="$namePrefix$arg2"
    docker exec -u root -it $name bash
    exit
fi

# help
echo "HELP"
echo ":"
echo "bin/dockerScript create_dockerImage %IMAGE%"
echo "bin/dockerScript build_image %IMAGE% [-force]"
echo "bin/dockerScript run_image %IMAGE%"
echo "bin/dockerScript shell %IMAGE%"
echo "bin/dockerScript shell_as_root %IMAGE%"
echo ":"
echo "Docker"
echo ":"
echo "RM IMAGE   --- docker rmi %IMAGE%"
echo "LIST IMAGE --- docker images"
echo "LIST RUNNING --- docker ps -a"
echo "SHELL        --- docker exec -it %NAME% bash"
echo "STOP         --- docker container rm -f %NAME%"









